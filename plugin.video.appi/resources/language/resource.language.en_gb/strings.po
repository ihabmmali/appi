msgid "Ask before playback uses InputStream Adaptive to show available HLS qualities before the stream starts."
msgstr "Ask before playback uses InputStream Adaptive to show available HLS qualities before the stream starts."

msgctxt "#32312"
msgid "Maximum HLS bitrate (Kbit/s)"
msgstr "Maximum HLS bitrate (Kbit/s)"

