msgstr "Offline media folder"

msgctxt "#32702"
msgid "Background download queue"
msgstr "Background download queue"

msgctxt "#32710"
msgid "Download folder"
msgstr "Download folder"

msgctxt "#32711"
msgid "Choose a writable local folder. Appi creates Movies and TV Shows subfolders here; add those subfolders as Kodi video sources. Compatible HLS video and audio are stream-copied into one file without re-encoding."
msgstr "Choose a writable local folder. Appi creates Movies and TV Shows subfolders here; add those subfolders as Kodi video sources. Compatible HLS video and audio are stream-copied into one file without re-encoding."

msgctxt "#32712"
msgid "Manage Downloads"
msgstr "Manage Downloads"

msgctxt "#32713"
msgid "Stop, resume, cancel or delete individual downloads and their partial files."
msgstr "Stop, resume, cancel or delete individual downloads and their partial files."

msgctxt "#32714"
msgid "Retry Failed Downloads"
msgstr "Retry Failed Downloads"

msgctxt "#32715"
msgid "Queues failed downloads again. Downloads pause automatically during video playback."
msgstr "Queues failed downloads again. Downloads pause automatically during video playback."
