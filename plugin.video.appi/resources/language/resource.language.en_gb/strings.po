msgid "Maintenance"
msgstr "Maintenance"

msgctxt "#32501"
msgid "Refresh catalogues"
msgstr "Refresh catalogues"

msgctxt "#32502"
msgid "Clear cached and saved data"
msgstr "Clear cached and saved data"

msgctxt "#32510"
msgid "Refresh Movie List"
msgstr "Refresh Movie List"

msgctxt "#32511"
msgid "Downloads the movie catalogue again and replaces its cache only when the refresh succeeds."
msgstr "Downloads the movie catalogue again and replaces its cache only when the refresh succeeds."

msgctxt "#32512"
msgid "Refresh TV Show List"
msgstr "Refresh TV Show List"

msgctxt "#32513"
msgid "Downloads all available TV catalogue pages again and rebuilds the indexed cache only when successful."
msgstr "Downloads all available TV catalogue pages again and rebuilds the indexed cache only when successful."

msgctxt "#32514"
msgid "Refresh All Lists"
msgstr "Refresh All Lists"

msgctxt "#32515"
msgid "Refreshes the movie list and then the TV show list."
msgstr "Refreshes the movie list and then the TV show list."

msgctxt "#32520"
msgid "Clear Movie List Cache"
msgstr "Clear Movie List Cache"

msgctxt "#32521"
msgid "Deletes the cached movie catalogue and movie stream checks. The configured source URL is kept."
msgstr "Deletes the cached movie catalogue and movie stream checks. The configured source URL is kept."

msgctxt "#32522"
msgid "Clear TV Show List Cache"
msgstr "Clear TV Show List Cache"

msgctxt "#32523"
msgid "Deletes the TV index, per-show episode caches and TV stream checks. The configured source URL is kept."
msgstr "Deletes the TV index, per-show episode caches and TV stream checks. The configured source URL is kept."

msgctxt "#32524"
msgid "Clear Both List Caches"
msgstr "Clear Both List Caches"

msgctxt "#32525"
msgid "Deletes both cached catalogues and their stream checks. Configured source URLs are kept."
msgstr "Deletes both cached catalogues and their stream checks. Configured source URLs are kept."

msgctxt "#32526"
msgid "Clear Saved Subtitles"
msgstr "Clear Saved Subtitles"

msgctxt "#32527"
msgid "Deletes all external subtitle files saved by Appi."
msgstr "Deletes all external subtitle files saved by Appi."

msgctxt "#32528"
msgid "Clear Recent Media"
msgstr "Clear Recent Media"

msgctxt "#32529"
msgid "Deletes Recently Played entries and their resume positions."
msgstr "Deletes Recently Played entries and their resume positions."

msgctxt "#32600"
msgid "Metadata"
msgstr "Metadata"

msgctxt "#32601"
msgid "On-demand metadata"
msgstr "On-demand metadata"

msgctxt "#32602"
msgid "Metadata cache"
msgstr "Metadata cache"

msgctxt "#32610"
msgid "Enable background metadata"
msgstr "Enable background metadata"

msgctxt "#32611"
msgid "Queues focused titles automatically. Folder and show context menus can explicitly queue everything beneath them; lookups run while playback and downloads are idle. Requires TMDb Helper."
msgstr "Queues focused titles automatically. Folder and show context menus can explicitly queue everything beneath them; lookups run while playback and downloads are idle. Requires TMDb Helper."

msgctxt "#32612"
msgid "Maximum cached titles"
msgstr "Maximum cached titles"

msgctxt "#32613"
msgid "Limits automatically discovered metadata. Explicit folder/show batches are retained; shared TV-show artwork and cast are stored once rather than copied into every episode."
msgstr "Limits automatically discovered metadata. Explicit folder/show batches are retained; shared TV-show artwork and cast are stored once rather than copied into every episode."

msgctxt "#32614"
msgid "Metadata Status"
msgstr "Metadata Status"

msgctxt "#32615"
msgid "Shows whether TMDb Helper is installed, cached and queued entry counts, and metadata disk usage."
msgstr "Shows whether TMDb Helper is installed, cached and queued entry counts, and metadata disk usage."

msgctxt "#32616"
msgid "Clear Metadata Cache"
msgstr "Clear Metadata Cache"

msgctxt "#32617"
msgid "Deletes cached plots, posters, cast, episode names and IMDb ratings."
msgstr "Deletes cached plots, posters, cast, episode names and IMDb ratings."

msgctxt "#32618"
msgid "Stop and Clear Metadata Queue"
msgstr "Stop and Clear Metadata Queue"

msgctxt "#32619"
msgid "Stops after any lookup already in progress and removes all pending metadata lookups. Cached metadata is kept."
msgstr "Stops after any lookup already in progress and removes all pending metadata lookups. Cached metadata is kept."

