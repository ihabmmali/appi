msgid "Requests one automatic refresh after the Appi background service starts, waiting until video playback is idle."
msgstr "Requests one automatic refresh after the Appi background service starts, waiting until video playback is idle."

msgctxt "#32545"
msgid "Automatic refresh interval"
msgstr "Automatic refresh interval"

msgctxt "#32546"
msgid "Minimum time between successful scheduled refresh checks. Failures retry sooner with backoff."
msgstr "Minimum time between successful scheduled refresh checks. Failures retry sooner with backoff."

msgctxt "#32547"
msgid "Use fast TV refresh automatically"
msgstr "Use fast TV refresh automatically"

msgctxt "#32548"
msgid "Uses the leading-window overlap algorithm for scheduled TV refreshes, with automatic full-refresh fallback when overlap cannot be proven."
msgstr "Uses the leading-window overlap algorithm for scheduled TV refreshes, with automatic full-refresh fallback when overlap cannot be proven."

