msgid "Runs refreshes only while video is not playing. Failed attempts use bounded exponential retry delay and existing caches are preserved on failed catalogue downloads."
msgstr "Runs refreshes only while video is not playing. Failed attempts use bounded exponential retry delay and existing caches are preserved on failed catalogue downloads."

msgctxt "#32543"
msgid "Refresh on Kodi/Appi service startup"
msgstr "Refresh on Kodi/Appi service startup"

