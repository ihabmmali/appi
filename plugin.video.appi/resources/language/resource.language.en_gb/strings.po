msgstr "Plain MP4 buffering"

msgctxt "#32331"
msgid "Manage Kodi HTTP cache for MP4"
msgstr "Manage Kodi HTTP cache for MP4"

msgctxt "#32332"
msgid "When enabled Appi updates Kodi's global HTTP cache settings before a plain MP4 starts."
msgstr "When enabled Appi updates Kodi's global HTTP cache settings before a plain MP4 starts."

msgctxt "#32333"
msgid "MP4 cache memory (MB)"
msgstr "MP4 cache memory (MB)"

msgctxt "#32334"
msgid "Kodi file-cache memory size. This is a global Kodi setting, not an Appi-only buffer."
msgstr "Kodi file-cache memory size. This is a global Kodi setting, not an Appi-only buffer."

msgctxt "#32335"
msgid "MP4 read factor"
msgstr "MP4 read factor"

msgctxt "#32336"
msgid "How aggressively Kodi reads ahead relative to playback bitrate. 4 means up to roughly 4x. This changes Kodi's global cache setting."
msgstr "How aggressively Kodi reads ahead relative to playback bitrate. 4 means up to roughly 4x. This changes Kodi's global cache setting."

msgctxt "#32400"
msgid "Subtitles"
msgstr "Subtitles"

msgctxt "#32401"
msgid "Downloaded subtitle persistence"
msgstr "Downloaded subtitle persistence"

msgctxt "#32410"
msgid "Save downloaded subtitles"
msgstr "Save downloaded subtitles"

msgctxt "#32411"
msgid "Copies newly downloaded external subtitle files from Kodi's temporary area into Appi's persistent profile storage when detected."
msgstr "Copies newly downloaded external subtitle files from Kodi's temporary area into Appi's persistent profile storage when detected."

msgctxt "#32412"
msgid "Automatically select saved subtitle"
msgstr "Automatically select saved subtitle"

msgctxt "#32413"
msgid "When a previously saved subtitle exists for the same movie or episode, Appi attaches and selects the most recently saved file."
msgstr "When a previously saved subtitle exists for the same movie or episode, Appi attaches and selects the most recently saved file."

msgctxt "#32214"
msgid "Items per page"
msgstr "Items per page"

msgctxt "#32215"
msgid "Maximum number of movies or TV shows Appi sends to Kodi at once. Smaller pages open faster on low-powered devices."
msgstr "Maximum number of movies or TV shows Appi sends to Kodi at once. Smaller pages open faster on low-powered devices."

