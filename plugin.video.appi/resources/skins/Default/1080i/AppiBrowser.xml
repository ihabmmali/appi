      <scrolltime>150</scrolltime>
      <itemlayout height="72" width="960">
        <control type="label">
          <left>22</left><top>0</top><width>915</width><height>72</height>
          <font>font16</font><textcolor>FFD8DEE9</textcolor>
          <aligny>center</aligny><label>$INFO[ListItem.Label]</label>
        </control>
      </itemlayout>
      <focusedlayout height="72" width="960">
        <control type="image">
          <left>0</left><top>2</top><width>950</width><height>68</height>
          <texture colordiffuse="FF168CCC">white.png</texture>
        </control>
        <control type="label">
          <left>22</left><top>0</top><width>915</width><height>72</height>
          <font>font16</font><textcolor>FFFFFFFF</textcolor>
