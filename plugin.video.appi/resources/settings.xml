        <setting id="hls_quality_mode" type="integer" label="32310" help="32311">
          <level>0</level>
          <default>1</default>
          <constraints>
            <options>
              <option label="32320">0</option>
              <option label="32321">1</option>
              <option label="32322">2</option>
