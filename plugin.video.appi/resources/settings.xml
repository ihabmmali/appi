          <constraints><minimum>0</minimum><maximum>1024</maximum></constraints>
          <control type="edit" format="integer"><heading>32333</heading></control>
        </setting>
        <setting id="mp4_read_factor" type="integer" label="32335" help="32336">
          <level>0</level><default>4</default>
          <constraints><minimum>1</minimum><maximum>50</maximum></constraints>
          <control type="edit" format="integer"><heading>32335</heading></control>
        </setting>
