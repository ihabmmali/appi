          <constraints><minimum>250</minimum><maximum>100000</maximum></constraints>
          <control type="edit" format="integer"><heading>32312</heading></control>
        </setting>
      </group>
      <group id="2" label="32330">
        <setting id="manage_mp4_buffer" type="boolean" label="32331" help="32332">
