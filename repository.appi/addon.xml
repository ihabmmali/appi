<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.appi"
       name="Appi Repository"
       version="1.2.0"
       provider-name="Eyecon">
  <extension point="xbmc.addon.repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/ihabmmali/appi/main/addons.xml</info>
      <checksum verify="sha256">https://raw.githubusercontent.com/ihabmmali/appi/main/addons.xml.sha256</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/ihabmmali/appi/main/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Repository for the Appi Kodi add-on</summary>
    <description lang="en_GB">Installs and updates Appi from the ihabmmali/appi GitHub repository.</description>
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/ihabmmali/appi</source>
  </extension>
</addon>
