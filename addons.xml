<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.video.appi" name="Appi" version="0.5.1" provider-name="Eyecon">
    <requires>
      <import addon="xbmc.python" version="3.0.1" />
      <import addon="inputstream.adaptive" version="21.0.0" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Movies and TV shows from user-configured M3U feeds</summary>
      <description lang="en_GB">Appi caches configurable movie and TV M3U catalogues, provides fast indexed browsing and scoped search, controls HLS quality and MP4 buffering, and can persist downloaded subtitles for replay.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/ihabmmali/appi</source>
      <news>0.5.1 - Fix settings-label localization regression while retaining indexed browsing, sorting, HLS quality control, MP4 buffering controls, visible Fire TV errors, and persistent subtitle reuse.</news>
    </extension>
  </addon>
  <addon id="repository.appi" name="Appi Repository" version="1.2.0" provider-name="Eyecon">
    <extension point="xbmc.addon.repository">
      <dir>
        <info compressed="false">https://raw.githubusercontent.com/ihabmmali/appi/main/addons.xml</info>
        <checksum verify="sha256">https://raw.githubusercontent.com/ihabmmali/appi/main/addons.xml.sha256</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/ihabmmali/appi/main/</datadir>
        <hashes>sha256</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Repository for the Appi Kodi add-on</summary>
      <description lang="en_GB">Installs and updates Appi from the ihabmmali/appi GitHub repository.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/ihabmmali/appi</source>
    </extension>
  </addon>
</addons>
